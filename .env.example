# ==========================================
# COMPANY_NAME Environment Configuration
# ==========================================

# Public Website URL (Canonical URL generator & OpenGraph)
NEXT_PUBLIC_SITE_URL="https://example.com"
APP_BASE_URL="https://example.com"

# ── Authentication (REQUIRED) ──────────────────────────────────────────────────
# Generate secure secrets with: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
# Minimum 32 characters each. Use DIFFERENT values for each secret.
JWT_SECRET="your-super-secret-jwt-key-minimum-32-chars-change-this"
JWT_ADMIN_SECRET="your-different-admin-jwt-secret-min-32-chars-change-this"

# ── Admin Account Provisioning ─────────────────────────────────────────────────
# Used ONLY during pnpm run seed:admin — remove ADMIN_PASSWORD from env after seeding.
ADMIN_EMAIL="admin@yourcompany.com"
ADMIN_USERNAME="admin"
ADMIN_FULL_NAME="Site Administrator"
ADMIN_PASSWORD="StrongAdminPassword@123"

# PostgreSQL Database Connection (Prisma ORM)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/company_db?schema=public"

# Transactional Email Notification Configuration
# Recipient email address where project inquiries will be routed
CONTACT_RECEIVER_EMAIL="inquiries@company-name.com"

# Provider Option A: Resend (Recommended)
RESEND_API_KEY=""
EMAIL_FROM="COMPANY_NAME <noreply@yourdomain.com>"

# Provider Option B: SMTP Gateway
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER="smtp-username"
SMTP_PASS="smtp-password"
SMTP_SECURE="false"

# Rate Limiting & Anti-Spam Options
CONTACT_RATE_LIMIT_PER_MINUTE="5"

# Google Sheets Database Integration
# Target Spreadsheet: https://docs.google.com/spreadsheets/d/1KCeS_yqhSyIPqOwlQA3tpoa8F49cE0WAmHaC_W9BnhY/edit
GOOGLE_SHEET_URL="https://docs.google.com/spreadsheets/d/1KCeS_yqhSyIPqOwlQA3tpoa8F49cE0WAmHaC_W9BnhY/edit"
GOOGLE_SHEET_WEBHOOK_URL=""

