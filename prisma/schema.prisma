datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ─── Auth Enums ───────────────────────────────────────────────────────────────

enum UserRole {
  USER
  ADMIN
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
  PENDING_VERIFICATION
}

// ─── Auth Models ─────────────────────────────────────────────────────────────

model User {
  id              String        @id @default(cuid())
  fullName        String
  username        String        @unique
  email           String        @unique
  passwordHash    String
  role            UserRole      @default(USER)
  emailVerified   Boolean       @default(false)
  emailVerifiedAt DateTime?
  accountStatus   AccountStatus @default(ACTIVE)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  lastLoginAt     DateTime?

  verificationTokens  VerificationToken[]
  passwordResetTokens PasswordResetToken[]
  adminActions        AdminAuditLog[]     @relation("AdminActions")
  targetedActions     AdminAuditLog[]     @relation("TargetedActions")

  @@index([email])
  @@index([username])
  @@index([role])
  @@index([accountStatus])
  @@index([createdAt])
  @@map("users")
}

model VerificationToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
  @@map("verification_tokens")
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
  @@map("password_reset_tokens")
}

model AdminAuditLog {
  id           String   @id @default(cuid())
  adminId      String
  action       String
  targetUserId String?
  metadata     Json?
  createdAt    DateTime @default(now())

  admin      User  @relation("AdminActions", fields: [adminId], references: [id])
  targetUser User? @relation("TargetedActions", fields: [targetUserId], references: [id])

  @@index([adminId])
  @@index([action])
  @@index([createdAt])
  @@map("admin_audit_logs")
}

// ─── Contact / Legacy Models ──────────────────────────────────────────────────

enum InquiryStatus {
  NEW
  UNDER_REVIEW
  CONTACTED
  ARCHIVED
}

enum ProjectType {
  CUSTOM_SOFTWARE
  PRODUCT_LICENSING
  AUTOMATION
  MODERNIZATION
  CONSULTING
  OTHER
}

model Inquiry {
  id                 String         @id @default(cuid())
  fullName           String
  email              String
  companyName        String?
  projectType        String
  budgetRange        String?
  projectDescription String         @db.Text
  status             InquiryStatus  @default(NEW)
  ipAddress          String?
  userAgent          String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  @@index([email])
  @@index([status])
  @@index([createdAt])
  @@map("inquiries")
}

model SecurityLog {
  id        String   @id @default(cuid())
  eventType String
  endpoint  String
  ipAddress String?
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([eventType])
  @@index([createdAt])
  @@map("security_logs")
}
